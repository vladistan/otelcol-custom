# cspell:ignore GOTOOLCHAIN tzdata
# Dockerfile for otelcol-gateway
# Real multi-stage build: the collector is generated and compiled inside the
# builder stage from a clean checkout, no host pre-build required.

# ---- builder stage ----
# go1.26.8, debian bookworm
FROM golang@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS builder

ARG OCB_VERSION=0.140.0
ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /src

# The builder digest above already ships go1.26.8, above every in-tree
# go.mod directive (highest is 1.24.0), so the toolchain is pinned to the
# image's own local go rather than left to auto-fetch. `auto` is what let
# the version drift silently before this phase - the Phase 0 baseline
# observed it fetching go1.26.8 mid-build even though the pin claimed an
# older version. `local` is Go's actual no-auto-fetch value; `off` is not
# a recognized GOTOOLCHAIN setting.
ENV GOTOOLCHAIN=local

# Install the OpenTelemetry Collector Builder (OCB) at the pinned version.
RUN go install go.opentelemetry.io/collector/cmd/builder@v${OCB_VERSION}

# Copy only what the gateway build needs: the root module, the shared
# entrypoint, the custom in-tree components, and the builder config.
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY processor ./processor
COPY receiver ./receiver
COPY stanza ./stanza
COPY builder-gateway.yaml ./

# Generate the gateway distribution (skip_compilation: true - OCB wires the
# components and go.mod but does not compile; compilation happens below,
# same as the local `just build-gateway` recipe). OCB does not create the
# output path recursively, so it must exist first.
RUN mkdir -p build/gateway && /go/bin/builder --config=builder-gateway.yaml

# Inject the shared entrypoint (adds Sentry init) and resolve dependencies,
# mirroring `just build-gateway`.
# hadolint ignore=DL3003
RUN cp cmd/otelcol-custom/main.go build/gateway/main.go && \
    cd build/gateway && \
    go get github.com/getsentry/sentry-go@v0.29.1 && \
    go mod tidy

# Compile the binary.
# hadolint ignore=DL3003
RUN cd build/gateway && \
    CGO_ENABLED=0 go build \
        -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.serviceName=otelcol-gateway" \
        -o otelcol-gateway .

# ---- runtime stage ----
# alpine 3.22.5
FROM alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# ARGs do not cross FROM boundaries; redeclare for the OCI labels below.
ARG VERSION=dev
ARG COMMIT=unknown

# OCI provenance labels, so GHCR links the public package to its source repo.
LABEL org.opencontainers.image.source="https://github.com/vladistan/claude-tools" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"

# Install ca-certificates for TLS connections to Elasticsearch
# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user for security
RUN addgroup -g 10001 -S otel && \
    adduser -u 10001 -S otel -G otel

# Create directories for config and storage
RUN mkdir -p /etc/otel /var/lib/otel/storage && \
    chown -R otel:otel /etc/otel /var/lib/otel

# Copy the binary compiled in the builder stage
COPY --from=builder --chown=otel:otel /src/build/gateway/otelcol-gateway /otelcol-gateway

# Use non-root user
USER otel

# Expose ports
# OTLP gRPC
EXPOSE 4317
# OTLP HTTP
EXPOSE 4318
# Syslog UDP
EXPOSE 4319/udp
# Syslog TCP
EXPOSE 4320
# Health check
EXPOSE 13133
# zpages (debug)
EXPOSE 55679

# Health check. Targets 127.0.0.1 explicitly, not localhost: the
# health_check extension binds 127.0.0.1 only, and busybox wget resolves
# `localhost` to the ::1 entry in Docker's /etc/hosts first, refusing the
# connection before it ever tries the v4 address.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:13133/ || exit 1

# Default entrypoint
ENTRYPOINT ["/otelcol-gateway"]
CMD ["--config", "/etc/otel/config.yaml"]
